server {
    listen 443 ssl http2;
    server_name yuk.birlikde.biz;

    root /var/www/yuk-birlikde-biz/public;
    index index.php;

    # ssl_certificate / ssl_certificate_key idarə olunur (Let's Encrypt və s.)
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Nömrəli path parametrləri olan endpointlər üçün pretty-URL → query string
    location ~ ^/api/v1/pages/([a-zA-Z0-9-]+)$ {
        rewrite ^ /api/v1/pages.php?slug=$1 last;
    }

    location /sse/ {
        proxy_read_timeout 3600s;
        try_files $uri $uri.php =404;
    }

    location /api/ {
        try_files $uri $uri.php =404;
    }

    # Yüklənmiş fayllar statik xidmət olunur — PHP icrası qadağandır (Hissə 11.1)
    location /uploads/ {
        alias /var/www/yuk-birlikde-biz/storage/uploads/;
        location ~ \.php$ { deny all; }
    }

    # SPA-shell: bütün digər marşrutlar index.php-yə düşür, client-side router idarə edir
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~ /\. {
        deny all;
    }
}
