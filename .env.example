# Birlikdə — Mühit Dəyişənləri Şablonu
# Bu faylı kopyalayıb .env adlandırın və əsl dəyərləri doldurun.
# .env faylı HEÇ VAXT git-ə commit edilmir (bax .gitignore).

APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.birlikde.biz
ADMIN_URL=https://appadmin.birlikde.biz
APP_TIMEZONE=Asia/Baku

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=birlikde
DB_USERNAME=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_CHARSET=utf8mb4

SESSION_NAME=birlikde_session
SESSION_LIFETIME=0
SESSION_SECURE=true
SESSION_SAMESITE=Lax

ADMIN_SESSION_NAME=birlikde_admin_session

CSRF_TOKEN_NAME=csrf_token

REMEMBER_ME_COOKIE=birlikde_remember
REMEMBER_ME_DAYS=365

ADMIN_SESSION_IDLE_MINUTES=15

PAYMENT_PROVIDER=payriff
# Payriff dashboard → Applications bölməsindən (bax PayriffProvider.php qeydi)
PAYRIFF_MERCHANT_ID=your_payriff_merchant_id_here
PAYRIFF_SECRET_KEY=your_payriff_secret_key_here
BIRBANK_MERCHANT_ID=your_birbank_merchant_id_here
BIRBANK_SECRET_KEY=your_birbank_secret_key_here
BIRBANK_PAYMENT_URL=https://api.birbank.az/placeholder/pay

VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@birlikde.biz

WHATSAPP_SUPPORT_NUMBER=994555949444

LOG_LEVEL=error
